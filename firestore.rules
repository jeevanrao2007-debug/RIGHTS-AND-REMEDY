rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile access: only authenticated user can read and write their profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Cases collection: strictly enforce ownership by request.auth.uid
    match /cases/{caseId} {
      allow read, update, delete: if request.auth != null && 
        (resource.data.user_id == request.auth.uid || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && 
        (request.resource.data.user_id == request.auth.uid || request.resource.data.userId == request.auth.uid);
    }

    // Documents collection: strictly enforce ownership
    match /documents/{docId} {
      allow read, update, delete: if request.auth != null && 
        (resource.data.user_id == request.auth.uid || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && 
        (request.resource.data.user_id == request.auth.uid || request.resource.data.userId == request.auth.uid);
    }

    // Authoritative legal source corpus: publicly readable, admin write only
    match /legal_sources/{sourceId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
