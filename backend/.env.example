# Rights & Remedy Navigator - Backend Configuration

# Gemini API Key (Secret, must not be exposed to frontend)
GEMINI_API_KEY=

# Google Cloud & Firebase Configuration
FIREBASE_PROJECT_ID=
# Path to service account json credentials (optional if running in GCP Cloud Run with attached service account)
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_CREDENTIALS_PATH=

# Server Configuration
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & CORS
ALLOWED_ORIGINS=*
MAX_UPLOAD_SIZE_BYTES=10485760
