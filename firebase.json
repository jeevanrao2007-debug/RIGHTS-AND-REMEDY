{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "rights-and-remedy",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Rights & Remedy Navigator",
        "supportEmail": "jeevanrao2007@gmail.com"
      }
    }
  }
}
